# Скопируйте в .env (make up сделает это сам) и при желании поменяйте значения.
# .env в git не попадает. Пароли — только буквы и цифры: они подставляются в URL.

# PostgreSQL
POSTGRES_USER=photobook
POSTGRES_PASSWORD=photobook
POSTGRES_DB=photobook

# S3-хранилище (локально RustFS). Эти же ключи — логин/пароль веб-консоли.
S3_ACCESS_KEY=photobook
S3_SECRET_KEY=photobooksecret
S3_BUCKET=photobook

# Порты на хосте (слушают только 127.0.0.1). Меняйте, если заняты.
POSTGRES_PORT=5432
S3_PORT=9000
S3_CONSOLE_PORT=9001
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Пароль админки (http://localhost:5173/admin/, логин admin). Без него админка выключена.
# Придумайте длинный: openssl rand -base64 18
ADMIN_PASSWORD=

# Заявки: за сколько дней минимум можно выбрать желаемую дату (время на печать).
ORDER_MIN_LEAD_DAYS=3

# Telegram-бот для уведомлений о заявках (см. README, «Telegram»).
# Без токена сообщения о заявках пишутся в лог: make logs.
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=-1001234567890

# Проверка с телефона в той же Wi-Fi сети (см. README). По умолчанию выключено.
# BIND_ADDR=0.0.0.0
# PUBLIC_HOST=192.168.1.10   # IP этого компьютера в локальной сети
